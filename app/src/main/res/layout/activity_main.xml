<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- Top bar: angle mode, memory register, history -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnAngle"
            style="@style/Chip"
            android:contentDescription="@string/cd_angle"
            android:text="@string/deg"
            android:textColor="@color/accent" />

        <TextView
            android:id="@+id/tvMemory"
            style="@style/Chip"
            android:layout_marginStart="8dp"
            android:text="@string/app_name"
            android:textColor="@color/text_muted"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnHistory"
            style="@style/Chip"
            android:text="@string/history" />
    </LinearLayout>

    <!-- Readout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:minHeight="96dp"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="end"
            android:maxLines="2"
            android:minHeight="24dp"
            android:textColor="@color/text_secondary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:autoSizeMaxTextSize="52sp"
            android:autoSizeMinTextSize="22sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-light"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="52sp" />
    </LinearLayout>

    <!-- Memory register -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnMc"
            style="@style/MemoryKey"
            android:text="MC" />

        <TextView
            android:id="@+id/btnMr"
            style="@style/MemoryKey"
            android:text="MR" />

        <TextView
            android:id="@+id/btnMPlus"
            style="@style/MemoryKey"
            android:text="M+" />

        <TextView
            android:id="@+id/btnMMinus"
            style="@style/MemoryKey"
            android:text="M−" />
    </LinearLayout>

    <!-- Keypad -->
    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="5"
        android:rowCount="7">

        <!-- Row 1 -->
        <TextView
            android:id="@+id/keyInv"
            style="@style/Key.Function"
            android:layout_row="0"
            android:layout_column="0"
            android:tag="inv"
            android:text="INV"
            android:textColor="@color/accent_soft" />

        <TextView
            style="@style/Key.Function"
            android:layout_row="0"
            android:layout_column="1"
            android:tag="lparen"
            android:text="(" />

        <TextView
            style="@style/Key.Function"
            android:layout_row="0"
            android:layout_column="2"
            android:tag="rparen"
            android:text=")" />

        <TextView
            style="@style/Key.Function"
            android:layout_row="0"
            android:layout_column="3"
            android:contentDescription="@string/cd_backspace"
            android:tag="back"
            android:text="⌫" />

        <TextView
            style="@style/Key.Danger"
            android:layout_row="0"
            android:layout_column="4"
            android:contentDescription="@string/cd_clear"
            android:tag="ac"
            android:text="AC" />

        <!-- Row 2 -->
        <TextView
            android:id="@+id/keySin"
            style="@style/Key.Function"
            android:layout_row="1"
            android:layout_column="0"
            android:contentDescription="@string/cd_sin"
            android:tag="sin"
            android:text="sin" />

        <TextView
            android:id="@+id/keyCos"
            style="@style/Key.Function"
            android:layout_row="1"
            android:layout_column="1"
            android:contentDescription="@string/cd_cos"
            android:tag="cos"
            android:text="cos" />

        <TextView
            android:id="@+id/keyTan"
            style="@style/Key.Function"
            android:layout_row="1"
            android:layout_column="2"
            android:contentDescription="@string/cd_tan"
            android:tag="tan"
            android:text="tan" />

        <TextView
            style="@style/Key.Function"
            android:layout_row="1"
            android:layout_column="3"
            android:tag="pi"
            android:text="π"
            android:textColor="@color/accent_soft" />

        <TextView
            style="@style/Key.Operator"
            android:layout_row="1"
            android:layout_column="4"
            android:tag="div"
            android:text="÷" />

        <!-- Row 3 -->
        <TextView
            android:id="@+id/keyLn"
            style="@style/Key.Function"
            android:layout_row="2"
            android:layout_column="0"
            android:contentDescription="@string/cd_ln"
            android:tag="ln"
            android:text="ln" />

        <TextView
            android:id="@+id/keyLog"
            style="@style/Key.Function"
            android:layout_row="2"
            android:layout_column="1"
            android:contentDescription="@string/cd_log"
            android:tag="log"
            android:text="log" />

        <TextView
            android:id="@+id/keySqrt"
            style="@style/Key.Function"
            android:layout_row="2"
            android:layout_column="2"
            android:contentDescription="@string/cd_sqrt"
            android:tag="sqrt"
            android:text="√" />

        <TextView
            style="@style/Key.Function"
            android:layout_row="2"
            android:layout_column="3"
            android:tag="e"
            android:text="e"
            android:textColor="@color/accent_soft" />

        <TextView
            style="@style/Key.Operator"
            android:layout_row="2"
            android:layout_column="4"
            android:tag="mul"
            android:text="×" />

        <!-- Row 4 -->
        <TextView
            style="@style/Key"
            android:layout_row="3"
            android:layout_column="0"
            android:tag="7"
            android:text="7" />

        <TextView
            style="@style/Key"
            android:layout_row="3"
            android:layout_column="1"
            android:tag="8"
            android:text="8" />

        <TextView
            style="@style/Key"
            android:layout_row="3"
            android:layout_column="2"
            android:tag="9"
            android:text="9" />

        <TextView
            style="@style/Key.Function"
            android:layout_row="3"
            android:layout_column="3"
            android:tag="pct"
            android:text="%" />

        <TextView
            style="@style/Key.Operator"
            android:layout_row="3"
            android:layout_column="4"
            android:tag="sub"
            android:text="−" />

        <!-- Row 5 -->
        <TextView
            style="@style/Key"
            android:layout_row="4"
            android:layout_column="0"
            android:tag="4"
            android:text="4" />

        <TextView
            style="@style/Key"
            android:layout_row="4"
            android:layout_column="1"
            android:tag="5"
            android:text="5" />

        <TextView
            style="@style/Key"
            android:layout_row="4"
            android:layout_column="2"
            android:tag="6"
            android:text="6" />

        <TextView
            style="@style/Key.Function"
            android:layout_row="4"
            android:layout_column="3"
            android:tag="sqr"
            android:text="x²" />

        <TextView
            style="@style/Key.Operator"
            android:layout_row="4"
            android:layout_column="4"
            android:tag="add"
            android:text="+" />

        <!-- Row 6 -->
        <TextView
            style="@style/Key"
            android:layout_row="5"
            android:layout_column="0"
            android:tag="1"
            android:text="1" />

        <TextView
            style="@style/Key"
            android:layout_row="5"
            android:layout_column="1"
            android:tag="2"
            android:text="2" />

        <TextView
            style="@style/Key"
            android:layout_row="5"
            android:layout_column="2"
            android:tag="3"
            android:text="3" />

        <TextView
            style="@style/Key.Function"
            android:layout_row="5"
            android:layout_column="3"
            android:tag="pow"
            android:text="xʸ" />

        <TextView
            style="@style/Key.Equals"
            android:layout_row="5"
            android:layout_rowSpan="2"
            android:layout_column="4"
            android:contentDescription="@string/cd_equals"
            android:tag="eq"
            android:text="=" />

        <!-- Row 7 -->
        <TextView
            style="@style/Key"
            android:layout_row="6"
            android:layout_column="0"
            android:tag="0"
            android:text="0" />

        <TextView
            style="@style/Key"
            android:layout_row="6"
            android:layout_column="1"
            android:tag="."
            android:text="." />

        <TextView
            style="@style/Key.Function"
            android:layout_row="6"
            android:layout_column="2"
            android:tag="ans"
            android:text="ANS" />

        <TextView
            style="@style/Key.Function"
            android:layout_row="6"
            android:layout_column="3"
            android:tag="fact"
            android:text="n!" />
    </GridLayout>
</LinearLayout>
